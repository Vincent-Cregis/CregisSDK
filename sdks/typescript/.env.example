# npm run test:sandbox loads .env when present and fails before testing if any
# read-only suite is missing credentials. Never commit a populated .env file.

WAAS_PID=
WAAS_API_KEY=
WAAS_ENDPOINT=
WAAS_WALLET_ID=
WITHDRAW_ADDRESS=

# Optional full-suite overrides.
WAAS_TEST_AMOUNT=0.001
WAAS_CHAIN_ID=198
WAAS_PAYOUT_TO_ADDRESS=
WITHDRAW_TO_ADDRESS=
WAAS_COLLECTION_TO_ADDRESS=

PAYMENT_PID=
PAYMENT_API_KEY=
PAYMENT_ENDPOINT=
PAYMENT_CREGIS_ID=

TEAM_ACCESS_KEY=
TEAM_ACCESS_SECRET=
TEAM_ENDPOINT=

# Mutating Sandbox coverage is intentionally separate and disabled by default.
CREGIS_ALLOW_MUTATING_TESTS=false
